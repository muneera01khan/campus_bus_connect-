{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated college member profile with assigned RBAC role.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Full name from Google authentication profile."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Full display name of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified college or Google email address."
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Firebase Authentication provider ID (e.g., google.com)."
        },
        "role": {
          "type": "string",
          "enum": ["student", "faculty", "hod", "tdc"],
          "description": "Assigned role governing dashboard access and Firestore permissions."
        },
        "department": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "Academic department or transport office."
        },
        "identifier": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Roll number, employee ID, or coordinator ID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest authenticated login."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "uid",
        "name",
        "displayName",
        "email",
        "provider",
        "role",
        "department",
        "identifier",
        "createdAt",
        "lastLoginAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Server-managed administrator UID allowlist created only via Firebase Console or Admin SDK.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the authorized administrator."
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160,
          "description": "Optional administrative note."
        }
      },
      "required": ["uid"]
    },
    "RoleAssignment": {
      "title": "RoleAssignment",
      "description": "Pre-approved role assignment keyed by lowercase email address, managed by an authorized administrator (HOD / Director).",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Lowercase email address matching the document ID."
        },
        "role": {
          "type": "string",
          "enum": ["student", "faculty", "hod", "tdc"],
          "description": "Pre-assigned role to grant on registration."
        },
        "department": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "Assigned department."
        },
        "assignedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the HOD/Director who created the assignment."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "role", "department", "assignedBy", "createdAt", "updatedAt"]
    },
    "BusSchedule": {
      "title": "BusSchedule",
      "description": "Public college bus route and two-shift college entry/exit timing record readable by all authenticated users.",
      "type": "object",
      "properties": {
        "busNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "College bus identifier (e.g., G-01)."
        },
        "routeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Bus route title (e.g., Indore to Campus)."
        },
        "firstShiftEntry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "description": "First Shift college entry time."
        },
        "firstShiftExit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "description": "First Shift college exit time."
        },
        "secondShiftEntry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "description": "Second Shift college entry time."
        },
        "secondShiftExit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "description": "Second Shift college exit time."
        },
        "status": {
          "type": "string",
          "enum": ["active", "maintenance", "inactive"],
          "description": "Operational bus status."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the TDC or HOD user who last modified the bus."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "busNumber",
        "routeName",
        "firstShiftEntry",
        "firstShiftExit",
        "secondShiftEntry",
        "secondShiftExit",
        "status",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "BusRestrictedDetail": {
      "title": "BusRestrictedDetail",
      "description": "Restricted bus operations data (driver contacts, registration, permit, capacity) accessible only to HOD, TDC, and approved Faculty.",
      "type": "object",
      "properties": {
        "busId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Matching BusSchedule document ID."
        },
        "busNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "driverName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "driverContact": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30
        },
        "conductorName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "conductorContact": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "vehicleRegistration": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "seatingCapacity": {
          "type": "integer"
        },
        "permitNumber": {
          "type": "string",
          "minLength": 0,
          "maxLength": 50
        },
        "insuranceExpiry": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "emergencyContact": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "operationalNotes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "busId",
        "busNumber",
        "driverName",
        "driverContact",
        "conductorName",
        "conductorContact",
        "vehicleRegistration",
        "seatingCapacity",
        "permitNumber",
        "insuranceExpiry",
        "emergencyContact",
        "operationalNotes",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "FacultyAccessRequest": {
      "title": "FacultyAccessRequest",
      "description": "Request submitted by a Faculty member for access to restricted bus details, reviewed by HOD/Director.",
      "type": "object",
      "properties": {
        "facultyUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "facultyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "facultyEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "reason": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "reviewerName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "reviewNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "facultyUid",
        "facultyName",
        "facultyEmail",
        "department",
        "employeeId",
        "reason",
        "status",
        "reviewedBy",
        "reviewerName",
        "reviewNote",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Server/Console-managed administrator UID allowlist (client writes forbidden)."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and assigned role document."
    },
    "/role_assignments/{emailKey}": {
      "schema": { "$ref": "#/entities/RoleAssignment" },
      "description": "Pre-assigned roles by lowercase email managed by HOD/Director."
    },
    "/buses/{busId}": {
      "schema": { "$ref": "#/entities/BusSchedule" },
      "description": "Public bus routes and shift timings."
    },
    "/bus_details/{busId}": {
      "schema": { "$ref": "#/entities/BusRestrictedDetail" },
      "description": "Restricted detailed bus records gated behind HOD/TDC/approved Faculty permissions."
    },
    "/faculty_requests/{facultyUid}": {
      "schema": { "$ref": "#/entities/FacultyAccessRequest" },
      "description": "Faculty requests for detailed bus information access."
    }
  }
}
